# Kopioi tämä tiedostoon .env (ei versionhallintaan) ja täytä arvot.
# Netlifyssä samat muuttujat asetetaan kohdassa Site configuration -> Environment variables.
# Muuttujia lukevat vain Netlify Functionit (palvelinpuoli); selaimeen ne eivät päädy.

# Google Cloud Console -> Google Auth Platform -> Clients -> Web application
# Authorized redirect URIs:
#   http://localhost:8888/api/auth/callback
#   https://kotinaytto.netlify.app/api/auth/callback
GOOGLE_CLIENT_ID=
# SALAINEN: merkitse Netlifyssä "Contains secret values". Älä koskaan committaa.
GOOGLE_CLIENT_SECRET=

# Jaettu salasana, jolla näyttö saa kysyä tapahtumat. Luo esim:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# SALAINEN: merkitse Netlifyssä "Contains secret values".
DISPLAY_ACCESS_KEY=
